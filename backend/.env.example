PORT=4000
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_URL=http://localhost:5173
FIREBASE_PROJECT_ID=office-gossip
GOOGLE_APPLICATION_CREDENTIALS=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=

# Optional fallback when sign-up emails fail: this code passes sign-up email verification (account stays unverified).
# Set to "dynamic" for a random single-use code per email, shown on the admin console "OTP codes" page
# (needs database/scheme.sql). Any other value is one fixed code for everyone.
DEV_MASTER_OTP=

# Set to true once email codes are sent (SMTP + template) to require verification at sign-up.
REQUIRE_EMAIL_OTP=false

# The API emails its own 6-digit codes when SMTP_HOST, SMTP_USER and SMTP_PASS are set (otherwise Supabase sends them).
# Gmail: smtp.gmail.com / 587 / your address / a 16-character app password. Brevo: smtp-relay.brevo.com / 587.
# Resend: smtp.resend.com / 465 / user "resend" / API key.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender shown in the inbox; must be allowed by your provider. Defaults to SMTP_USER.
MAIL_FROM=Office Gossip <no-reply@example.com>
